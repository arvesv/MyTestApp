# Set default behavior to automatically handle line endings
* text=auto

# Source code
*.cs text diff=csharp
*.sln text eol=crlf
*.csproj text
*.props text
*.targets text
*.xml text
*.config text
*.json text
*.json5 text

# Web files
*.html text
*.css text
*.js text
*.ts text

# Documentation & configuration
*.md text
*.txt text
*.yml text
*.yaml text
.gitignore text
.gitattributes text
.dockerignore text
Dockerfile text

# Scripts
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text

# Binary formats (prevent corruption from line-ending conversion)
*.dll binary
*.exe binary
*.pdb binary
*.so binary
*.dylib binary
*.zip binary
*.tar.gz binary
*.7z binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

